---
const { items = [] } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Home</a><span aria-hidden="true">/</span>
  {items.map((item, index) => <>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}{index < items.length - 1 && <span aria-hidden="true">/</span>}</>)}
</nav>
