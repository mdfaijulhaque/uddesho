---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro';
import countries from '../content/countries/countries.json'; import scholarships from '../content/scholarships/scholarships.json'; import guides from '../content/guides/guides.json'; import articles from '../content/articles/articles.json';
const index=[...countries.map(x=>({title:x.nameBn,type:'Country',summary:x.summary,url:`/study-destinations/${x.slug}/`})),...scholarships.map(x=>({title:x.name,type:'Scholarship',summary:x.summary,url:`/scholarships/${x.slug}/`})),...guides.map(x=>({title:x.title,type:'Guide',summary:x.summary,url:`/guides/${x.slug}/`})),...articles.map(x=>({title:x.title,type:'Article',summary:x.summary,url:`/articles/${x.slug}/`}))];
---
<BaseLayout title="Website Search"><header class="page-hero"><div class="container"><Breadcrumbs items={[{label:'Search'}]} /><p class="eyebrow">Site search</p><h1>Country, scholarship, guide ও article খুঁজুন</h1><div class="search-wrap" style="max-width:720px;margin-top:1.5rem"><label for="site-search">Search</label><input id="site-search" type="search" placeholder="যেমন: Italy, MEXT, SOP..." autofocus /></div></div></header><section class="section"><div class="container"><p id="search-count" class="muted">Keyword লিখে খোঁজা শুরু করুন।</p><div id="search-grid" class="grid grid-3"></div></div></section><script type="application/json" id="search-data" set:html={JSON.stringify(index)}></script><script is:inline>
const input=document.getElementById('site-search'),grid=document.getElementById('search-grid'),count=document.getElementById('search-count'),data=JSON.parse(document.getElementById('search-data').textContent); const params=new URLSearchParams(location.search); input.value=params.get('q')||'';
const render=()=>{const q=input.value.trim().toLowerCase(); const items=q?data.filter(x=>(`${x.title} ${x.type} ${x.summary}`).toLowerCase().includes(q)):[]; count.textContent=q?`${items.length}টি result পাওয়া গেছে`:'Keyword লিখে খোঁজা শুরু করুন।'; grid.innerHTML=items.map(x=>`<article class="card"><span class="tag">${x.type}</span><h3 style="margin-top:.8rem">${x.title}</h3><p class="muted">${x.summary}</p><a class="button button-soft" href="${x.url}">বিস্তারিত দেখুন →</a></article>`).join('');}; input.addEventListener('input',render); render();
</script></BaseLayout>
