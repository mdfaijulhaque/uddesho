---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import articles from '../../content/articles/articles.json';
export function getStaticPaths(){return articles.map((article)=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props;
const formatDate=(date)=>new Intl.DateTimeFormat('bn-BD',{year:'numeric',month:'long',day:'numeric'}).format(new Date(date));
---
<BaseLayout title={article.title} description={article.summary} type="article"><header class="page-hero"><div class="container"><Breadcrumbs items={[{label:'Articles',href:'/articles/'},{label:article.title}]} /><p class="eyebrow">{article.category}</p><h1>{article.title}</h1><p class="lead">{article.summary}</p><p class="muted">প্রকাশ: {formatDate(article.published)} · Last updated: {formatDate(article.updated)}</p></div></header><section class="section"><div class="container" style="max-width:820px"><h2>মূল ধারণা</h2><p>Study-abroad information ব্যবহার করার আগে source, date, programme এবং applicant category মিলিয়ে দেখা জরুরি। একই scholarship বা university-এর requirement intake এবং year অনুযায়ী বদলাতে পারে।</p><h2>করণীয়</h2><ul class="clean-list"><li>Official university, scholarship বা embassy page খুলুন</li><li>Current intake/call-এর publication date দেখুন</li><li>Eligibility ও required documents নিজের profile-এর সঙ্গে মিলান</li><li>Deadline-এর timezone ও document processing time note করুন</li><li>Submitted form ও confirmation সংরক্ষণ করুন</li></ul><p class="notice">এই article educational overview। Final decision-এর আগে official source যাচাই করুন।</p><div class="button-row"><a class="button button-primary" href="/guides/">Application Guides</a><a class="button button-outline" href="/student-support/">Personalized support</a></div></div></section></BaseLayout>
