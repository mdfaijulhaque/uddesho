<html>
<head>
<title>Uddesho Student Registration</title>

<style>
body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f5f8f7;
}

.container{
    width:400px;
    margin:80px auto;
    background:white;
    padding:35px;
    border-radius:20px;
    box-shadow:0 10px 30px #0002;
}

h1{
    text-align:center;
    color:#073b3a;
}

input{
    width:100%;
    padding:12px;
    margin:10px 0;
    border:1px solid #ddd;
    border-radius:8px;
}

button{
    width:100%;
    padding:14px;
    background:#00a878;
    color:white;
    border:none;
    border-radius:10px;
    font-size:16px;
}

p{
    text-align:center;
}
</style>

</head>

<body>

<div class="container">

<h1>Uddesho Registration</h1>

<p>Create your student account</p>

<input placeholder="Full Name">

<input placeholder="Email">

<input placeholder="Phone Number">

<input placeholder="Password" type="password">

<button>
Create Account
</button>

<p>
Already have account?
<a href="/auth/login">
Login
</a>
</p>

</div>

</body>
</html>
