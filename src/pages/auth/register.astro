---
---

<html>
<head>
<title>Uddesho Student Registration</title>

<style>
body{
margin:0;
font-family:Arial,sans-serif;
background:#f5f8f7;
}

.container{
width:420px;
margin:50px auto;
background:white;
padding:35px;
border-radius:20px;
box-shadow:0 10px 30px #0002;
}

.logo{
text-align:center;
color:#008c85;
font-size:28px;
font-weight:800;
}

h2{
text-align:center;
color:#123b3b;
}

input{
width:100%;
padding:14px;
margin:10px 0;
border:1px solid #ddd;
border-radius:10px;
font-size:15px;
box-sizing:border-box;
}

button{
width:100%;
padding:15px;
margin-top:15px;
border:none;
border-radius:12px;
background:linear-gradient(135deg,#ff8a00,#ff4d00);
color:white;
font-size:16px;
font-weight:bold;
cursor:pointer;
}

button:hover{
transform:translateY(-2px);
}

.login{
text-align:center;
margin-top:20px;
}

a{
color:#008c85;
font-weight:bold;
}

</style>

</head>

<body>

<div class="container">

<div class="logo">
UDDESHO
</div>

<h2>Create Student Account</h2>


<form>

<input type="text" placeholder="Full Name">

<input type="email" placeholder="Email Address">

<input type="tel" placeholder="Phone Number">

<input type="password" placeholder="Password">

<input type="password" placeholder="Confirm Password">


<button>
Create Account
</button>

</form>


<div class="login">
Already have an account?
<a href="/auth/login">Login</a>
</div>


</div>

</body>
</html>





