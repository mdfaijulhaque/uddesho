---

<html>
<head>
<title>Uddesho Student Registration</title>

<style>

*{
box-sizing:border-box;
}

body{
margin:0;
font-family:Arial,sans-serif;
min-height:100vh;
display:flex;
justify-content:center;
align-items:center;
background:linear-gradient(135deg,#f8fffd,#fff7ef);
}


.container{

width:450px;
background:white;
padding:40px;
border-radius:25px;
box-shadow:0 20px 50px rgba(0,0,0,0.12);

}


.logo{

text-align:center;
font-size:32px;
font-weight:800;
color:#008c85;
margin-bottom:5px;

}

.logo span{
color:#ff8a3d;
}


h1{

text-align:center;
color:#123b3b;
font-size:28px;
margin:10px 0;

}


.subtitle{

text-align:center;
color:#666;
margin-bottom:30px;

}


input,select{

width:100%;
padding:14px;
margin:8px 0;

border:1px solid #ddd;
border-radius:12px;

font-size:15px;

transition:.3s;

}


input:focus,
select:focus{

outline:none;
border-color:#008c85;
box-shadow:0 0 8px rgba(0,140,133,.25);

}



button{

width:100%;
padding:15px;
margin-top:20px;

border:none;
border-radius:14px;

background:linear-gradient(135deg,#ff8a3d,#ff5733);

color:white;

font-size:17px;

font-weight:bold;

cursor:pointer;

transition:.3s;

}


button:hover{

transform:translateY(-3px);

box-shadow:0 10px 25px rgba(255,100,50,.35);

}



.login{

text-align:center;
margin-top:25px;

}


.login a{

color:#008c85;
font-weight:bold;
text-decoration:none;

}


</style>

</head>


<body>


<div class="container">


<div class="logo">
UDDESHO <span>ABROAD</span>
</div>


<h1>
Student Registration
</h1>


<p class="subtitle">
Create your Uddesho student account
</p>



<form>


<input 
type="text"
placeholder="Full Name"
/>



<input
type="email"
placeholder="Email Address"
/>



<input
type="tel"
placeholder="Phone Number"
/>



<input
type="date"
/>



<select>

<option>Select Gender</option>

<option>Male</option>

<option>Female</option>

<option>Other</option>

</select>



<select>

<option>Select Education Level</option>

<option>SSC</option>

<option>HSC</option>

<option>Bachelor</option>

<option>Master</option>

</select>




<input
type="password"
placeholder="Password"
/>



<input
type="password"
placeholder="Confirm Password"
/>



<button>

Create Account

</button>



</form>



<div class="login">

Already have an account?

<a href="/auth/login">

Login

</a>


</div>



</div>


</body>

</html>
