---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import Icon from '../components/Icon.astro'; import {siteConfig} from '../config';
const areas=[['IELTS preparation','Test format, skill plan এবং practice routine।'],['Spoken English','দৈনন্দিন communication ও confidence building।'],['Academic English','Lecture, reading, note-taking ও classroom language।'],['Writing skills','Clear paragraph, coherence ও formal tone।'],['Interview English','নিজের profile ও goal naturalভাবে ব্যাখ্যা।'],['SOP writing fundamentals','Application writing-এর structure, evidence ও editing।'],['Learning resources','Practice source বাছাই ও consistent study plan।']];
---
<BaseLayout title="English with Uddesho"><header class="page-hero"><div class="container"><Breadcrumbs items={[{label:'English with Uddesho'}]} /><p class="eyebrow">Language learning</p><h1>Study abroad-এর জন্য practical English</h1><p class="lead">IELTS-এর বাইরে academic writing, interview communication এবং application-writing fundamentals আলাদাভাবে শিখুন।</p></div></header><section class="section"><div class="container"><div class="grid grid-3">{areas.map(([title,text])=><article class="card"><div class="icon-circle"><Icon name="book" /></div><h3>{title}</h3><p class="muted">{text}</p></article>)}</div></div></section><section class="section-sm"><div class="container"><div class="cta-panel"><h2>English with Uddesho অনুসরণ করুন</h2><p>IELTS, spoken English, writing এবং interview practice-এর নতুন content Facebook page-এ দেখুন।</p><a class="button button-secondary" href={siteConfig.socials.english} target="_blank" rel="noopener noreferrer">Follow English with Uddesho <Icon /></a></div></div></section></BaseLayout>
