---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import Icon from '../components/Icon.astro'; import {siteConfig} from '../config';
---
<BaseLayout title="About Uddesho Abroad"><header class="page-hero"><div class="container"><Breadcrumbs items={[{label:'About Us'}]} /><p class="eyebrow">Student-first platform</p><h1>তথ্য বুঝে নিজের সিদ্ধান্ত নেওয়ার পাশে</h1><p class="lead">Uddesho Abroad is a student-focused information and support platform created to help Bangladeshi students understand international education opportunities, scholarships, application documents and country-specific processes in simple Bangla.</p></div></header><section class="section"><div class="container"><div class="grid grid-2" style="gap:2rem"><article class="card"><p class="eyebrow">Mission</p><h2>জটিল process সহজ করা</h2><p>Bangla ভাষায় organized, practical এবং source-conscious information দিয়ে শিক্ষার্থী ও guardian-কে application planning বুঝতে সাহায্য করা।</p></article><article class="card"><p class="eyebrow">Vision</p><h2>তথ্যভিত্তিক student community</h2><p>যেখানে misleading promise নয়, official source, realistic preparation এবং student-first decision-making গুরুত্ব পায়।</p></article></div><div class="section"><h2>Platform যা প্রদান করে</h2><div class="grid grid-3"><article class="card"><h3>Free information</h3><p class="muted">Country, scholarship, document, finance ও visa preparation guide।</p></article><article class="card"><h3>Verification commitment</h3><p class="muted">Unverified deadline বা benefit প্রকাশ না করা এবং official source-এ পাঠানো।</p></article><article class="card"><h3>Personalized support</h3><p class="muted">প্রয়োজন অনুযায়ী shortlisting, writing ও document organization support।</p></article></div></div><p class="notice">Uddesho Abroad কোনো embassy, government organization, university বা official representative নয়।</p><div class="button-row" style="margin-top:1.5rem"><a class="button button-primary" href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer">WhatsApp-এ যোগাযোগ <Icon /></a><a class="button button-outline" href="/communities/">Community links</a></div></div></section></BaseLayout>
